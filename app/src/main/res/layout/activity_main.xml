<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="12dp">
 <androidx.camera.view.PreviewView android:id="@+id/preview" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" app:implementationMode="performance"/>
 <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Ready" android:padding="8dp"/>
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"><Button android:id="@+id/photo" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Photo"/><Button android:id="@+id/video" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Video"/><Button android:id="@+id/switch_camera" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Switch"/></LinearLayout>
</LinearLayout>